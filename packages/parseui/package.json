{
  "name": "parseui",
  "version": "1.0.0",
  "description": "ParseUI for npm: wrap any HTML in <parse-ui> for ParseUI's design in a shadow root. The library itself is served from cdn.parseui.com \u2014 this package loads it.",
  "type": "module",
  "license": "MIT",
  "author": "Parselab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parselab/parselab-ui.git",
    "directory": "packages/parseui"
  },
  "keywords": [
    "web-components",
    "shadow-dom",
    "custom-elements",
    "ui-kit",
    "design-system",
    "cdn"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/npm",
    "dist/types"
  ],
  "sideEffects": true,
  "main": "./dist/npm/parseui.js",
  "module": "./dist/npm/parseui.js",
  "types": "./dist/types/loader.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/loader.d.ts",
      "import": "./dist/npm/parseui.js"
    },
    "./jsx": {
      "types": "./dist/types/jsx.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vite build --mode npm && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
