{
  "name": "@parseui/icons",
  "version": "1.0.0",
  "description": "ParseUI's icon set \u2014 1,800+ icons on a 24px grid with a 1.8px stroke, based on Lucide. React components, raw SVGs, and the name \u2192 SVG map ParseUI's <i icon> uses.",
  "type": "module",
  "license": "MIT AND ISC",
  "author": "Parselab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parselab/parselab-ui.git",
    "directory": "packages/icons"
  },
  "keywords": [
    "icons",
    "lucide",
    "parseui",
    "react",
    "svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-lucide"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons.json": "./dist/icons.json",
    "./tags.json": "./dist/tags.json",
    "./svg/*": "./dist/svg/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "import:lucide": "node scripts/import-lucide.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
