{
  "name": "@parselabllc/ui",
  "version": "0.1.0",
  "description": "Parselab's Web Component UI library — <p-button> and friends, usable from any React-based framework (Next.js, Remix) and beyond.",
  "type": "module",
  "license": "MIT",
  "author": "Parselab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parselab/parselab-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://parselab.dev/docs/admin",
  "keywords": [
    "web-components",
    "custom-elements",
    "preact",
    "react",
    "nextjs",
    "remix",
    "ui-library",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/esm/index.js",
    "./dist/esm/components/**/*.js"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/cjs/react.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types && npm run build:manifest && npm run build:assets",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/types",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "build:assets": "cp src/tokens/tokens.css dist/tokens.css",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@lit/react": "^1.0.5",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@types/react": "^18.3.12",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
